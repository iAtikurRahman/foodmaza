# Copy to `.env` and adjust if needed. All values have safe defaults,
# so `docker compose up -d` also works without a root .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=foodmaaza

# Host port for PostgreSQL (must not clash with a system PostgreSQL on 5432)
DB_PORT=5433

# JWT signing secret — keep identical to backend/.env JWT_SECRET
JWT_SECRET=foodmaaza-dev-jwt-secret

# Docker service ports (backend 5000, frontend 3000)
BACKEND_PORT=5000
FRONTEND_PORT=3000

# CORS: browser origin the backend allows (keep in sync with FRONTEND_PORT)
CLIENT_URL=http://localhost:3000

# Browser-facing API URL baked into the frontend image at build time.
# Keep in sync with BACKEND_PORT.
# Rebuild after changing: docker compose build frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
