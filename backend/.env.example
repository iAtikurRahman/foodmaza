# Copy this file to `.env` and fill in real values.

# Backend HTTP port
PORT=5001

# CORS: the frontend origin allowed to call the API
CLIENT_URL=http://localhost:3000

# JWT signing secret — replace with a long random string in production
# e.g. openssl rand -hex32  (keep in sync with the root .env used by compose)
JWT_SECRET=change-me-in-production

# PostgreSQL connection string.
# Local `npm run dev`: DB runs in Docker Compose, published on host port 5433.
# Docker mode: the backend container uses db:5432 instead (set by compose).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/foodmaaza?schema=public"
