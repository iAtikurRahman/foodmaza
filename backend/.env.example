# Copy this file to `.env` and fill in real values.

# Backend HTTP port
PORT=5000

# CORS: the frontend origin allowed to call the API
CLIENT_URL=http://localhost:3000

# JWT signing secret — replace with a long random string in production
# e.g. openssl rand -hex32
JWT_SECRET=change-me-in-production

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/foodmaaza?schema=public"
